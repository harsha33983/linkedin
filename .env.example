# ─── Database (Neon PostgreSQL) ──────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── AI Provider ─────────────────────────────────────────────
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your-groq-api-key
AI_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=sk-your-openai-key-here

# ─── LinkedIn OAuth 2.0 ─────────────────────────────────────
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/auth/linkedin/callback
LINKEDIN_API_VERSION=202408

# ─── Auth ────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=http://localhost:3001

# ─── App URL (used for OAuth redirects) ─────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ─── Redis (BullMQ) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Encryption ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your-64-char-hex-encryption-key

# ─── LinkedIn Profile Review data provider ───────────────────
# Provider selection: auto | official | apify | proxycurl | third_party | manual | none
#  - auto: apify if APIFY_API_TOKEN + APIFY_LINKEDIN_PROFILE_ACTOR are set, else
#          proxycurl if PROXYCURL_API_KEY is set, else third_party if
#          PROFILE_DATA_API_* are set, else LinkedIn official (auth required)
#  - official: LinkedIn approved APIs only (OpenID userinfo — no scraping)
#  - apify: run an Apify LinkedIn-profile Actor and read its dataset.
#    Credentials never leave the server; the actor id may be
#    "owner~actor-name" or the full Apify id. Public-profile data only —
#    no login cookies, no li_at, no CAPTCHA/anti-bot bypass.
#  - proxycurl: Proxycurl LinkedIn Profile API (https://nubela.co/proxycurl)
#    Retrieves name, headline, summary, experience, education, skills,
#    certifications, languages, projects, volunteering, recommendations.
#    Needs a paid Proxycurl account; key never leaves the server.
#  - third_party: generic authorized REST profile-data provider
#  - manual: user-supplied content only (paste / PDF)
#  - none: retrieval disabled
PROFILE_DATA_PROVIDER=auto

# Apify provider
APIFY_API_TOKEN=
# Actor id, e.g. logiover~linkedin-profile-scraper
APIFY_LINKEDIN_PROFILE_ACTOR=
# Optional override (tests / self-hosted Apify) — defaults to https://api.apify.com
APIFY_API_URL=

# Proxycurl provider
PROXYCURL_API_KEY=
# Optional Proxycurl endpoint override (defaults to the public v2 endpoint)
PROXYCURL_API_URL=
# Generic third-party provider (POST {url} JSON, Authorization: Bearer)
PROFILE_DATA_API_URL=
PROFILE_DATA_API_KEY=

# Free-usage limits for the profile review tool (defaults: 3/day anonymous, 5/month authenticated)
FREE_PROFILE_REVIEWS_PER_DAY=3
AUTH_PROFILE_REVIEWS_PER_MONTH=5

# Short cache TTL for public profile data (ms). Provider terms + law govern retention.
PROFILE_REVIEW_CACHE_TTL_MS=86400000

# ─── Mock Mode (set to "false" to use Neon DB) ──────────────
USE_MOCK_DB=true

# ── Viral Posts scraper (internal Python service; server-side only) ──
SCRAPER_SERVICE_URL=http://127.0.0.1:8100
# Shared secret sent to the scraper service as X-Internal-Token
SCRAPER_INTERNAL_TOKEN=
# mock = zero external requests (deterministic local data) | scrapegraphai = live
SCRAPER_MODE=mock
SCRAPER_CACHE_TTL_MINUTES=30
