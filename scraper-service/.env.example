[TEMPLATE]
# Internal shared token the Next.js backend sends (X-Internal-Token). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SCRAPER_INTERNAL_TOKEN=

# Port for the service (Next.js expects SCRAPER_SERVICE_URL to point here)
SCRAPER_PORT=8100

# scrapling = live scraping via Scrapling library | mock = zero-external-request test data
SCRAPER_MODE=mock

# Scrapling fetch mode:
#   auto     = Fetcher first, escalate to StealthyFetcher on failure (recommended)
#   fetch    = Fetcher only (fast, HTTP-level, no browser)
#   stealth  = StealthyFetcher only (bypasses Cloudflare/Turnstile)
#   dynamic  = DynamicFetcher (full Playwright browser, slowest but most reliable)
SCRAPER_FETCH_MODE=auto

# ── agent-reach channels (github.com/Panniantong/agent-reach) ──
# on  = Jina Reader (agent-reach "web" channel) is the PRIMARY page fetcher;
#       Scrapling fetchers remain as fallback. Set "off" to disable.
SCRAPER_AGENT_REACH=off
# Optional jina.ai API key — raises rate limits, never required
JINA_API_KEY=
JINA_READER_TIMEOUT=45
# Discovery also uses agent-reach "exa_search" channel when installed:
#   npm install -g mcporter
#   mcporter config add exa https://mcp.exa.ai/mcp --scope home
# (skipped automatically when mcporter is absent)

# Search discovery (DuckDuckGo HTML + Google recency, no key needed)
SCRAPER_SEARCH_RESULTS=10

# Extraction tuning
SCRAPER_MAX_CONCURRENCY=3
SCRAPER_EXTRACTION_TIMEOUT=60
SCRAPER_FETCH_DELAY=2.0

# Cache
SCRAPER_CACHE_TTL_MINUTES=30
SCRAPER_CACHE_MAX_ENTRIES=200

# Safety
SCRAPER_MAX_POSTS=40
